<tr class="text-center">
<th scope="row">
  <% if event.type == 'Meeting' %>
    <%= link_to event_numb(index), events_meeting_path(event, locale: I18n.locale) %>
  <% else %>
    <%= link_to event_numb(index), events_notification_path(event, locale: I18n.locale) %>
  <% end %>
</th>
<td><%= event.name %></td>
<td><%= event.category.name %></td>
<td><%= l(event.event_date, format: :default) %></td>
</tr>